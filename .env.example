# SkyDash Configuration
# Copy to .env and adjust as needed

# Backend
SKYDASH_PORT=8001
SKYDASH_HOST=0.0.0.0
SKYDASH_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SKYDASH_API_KEY=              # Empty = no auth (dev mode). Set for production.

# Frontend (used in vite.config.js via import.meta.env)
VITE_API_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001
