# SkyDash Configuration
# Copy to .env and adjust as needed

# Backend
SKYDASH_PORT=8001
SKYDASH_HOST=0.0.0.0
SKYDASH_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SKYDASH_API_KEY=              # Empty = no auth (dev mode). Set for production.
SKYDASH_JWT_SECRET=           # Set a long random value when auth is enabled.

# Optional CrewAI / OpenAI-compatible model provider settings.
# These are only used when the optional crew profile is run manually.
MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
SKYDASH_CREW_FOCUS=SkyDash operating readiness from the Docker stack
SKYDASH_CREW_DATE=

# Frontend (used in vite.config.js via import.meta.env)
VITE_API_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001
# Optional browser-safe ADS-B proxy. Leave empty to use the backend
# /api/connectors/adsb route when VITE_API_URL is configured.
VITE_ADSB_URL=
