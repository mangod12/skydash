FROM python:3.13-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV SKYDASH_REPO_ROOT=/workspace

RUN pip install --no-cache-dir uv

COPY . /workspace

WORKDIR /workspace/skydash_intel_crew

RUN uv sync --frozen --no-dev

CMD uv run skydash_intel_crew "${SKYDASH_CREW_FOCUS:-SkyDash operating readiness from the Docker stack}"
